<div class="container mt-4">
  <h1><%= @list.name %></h1>
  <%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-primary mb-3" %>

  <div class="row">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="col-md-3 mb-3">
        <div class="card">
          <img src="<%= bookmark.movie.poster_url %>" class="card-img-top">
          <div class="card-body">
            <h5><%= bookmark.movie.title %></h5>
            <p><%= bookmark.comment %></p>
            <%= link_to "Remove", bookmark_path(bookmark),
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                class: "btn btn-sm btn-danger" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%= link_to "Back to lists", lists_path %>
</div>
